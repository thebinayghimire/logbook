# Logbook authorization bridge
# Copy this file to .env, fill in the values, then run: npm start
# Requires Node.js 22.13 or newer.

# Create an OAuth app at https://github.com/settings/developers
# Homepage URL:              http://127.0.0.1:8080
# Authorization callback:    http://127.0.0.1:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must exactly match the OAuth app's callback URL. Use the same hostname
# (localhost or 127.0.0.1) that you open in the browser.
GITHUB_CALLBACK_URL=http://127.0.0.1:8080/auth/github/callback

# repo          read + write private repositories (the proxy only issues reads;
#               Commit Now writes through local git, never this token)
# read:org      organizations
# read:user     profile details
# user:email    verified email addresses for commit attribution
# gist          gists
GITHUB_SCOPE=repo read:org read:user user:email gist

# --- Server -----------------------------------------------------------------

PORT=8080
HOST=127.0.0.1

# Set to production on a real deployment. This enables startup warnings for
# unsafe production configuration.
NODE_ENV=development

# --- Authorization ----------------------------------------------------------

# Adopt the token from `gh auth login` for local development.
# The bridge enables this automatically only on a loopback HOST. If you copy
# this file to a proxied or public host, keep it at 0. Never enable it there.
ALLOW_LOCAL_AUTH=0

# Local-only Commit Now. When enabled, an authenticated user can choose a
# folder on this machine, preview uncommitted changes, and run git commit /
# git push with the machine's existing credentials. It is forced off unless
# HOST is a loopback address. Do not enable it on a shared or proxied host.
ENABLE_COMMIT_NOW=0

# Fixed lifetime of a persistent server session, in hours.
SESSION_TTL_HOURS=12

# --- Storage ----------------------------------------------------------------

# Skip a background scan on page load when the stored snapshot is newer than
# this many milliseconds. Set to 0 to validate freshness on every load.
SNAPSHOT_FRESH_MS=60000

# Required in production: 32 random bytes encoded as base64 or 64 hex chars.
# Encrypts snapshots and session tokens. When omitted locally, Logbook creates
# a development-only key under LOGBOOK_DATA_DIR. Changing this key makes
# existing sessions and snapshots unreadable; there is no in-place rotation.
SNAPSHOT_ENCRYPTION_KEY=

# SQLite database, WAL files, and the development encryption key are stored
# here. Mount this on a persistent volume in production.
LOGBOOK_DATA_DIR=./data

# --- Sync scope -------------------------------------------------------------

# Exclude bots and merge commits by default so totals describe authored work.
INCLUDE_BOTS=0
INCLUDE_MERGE_COMMITS=0

# --- Deployment -------------------------------------------------------------

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Otherwise clients can spoof their IP and bypass per-IP rate limits.
TRUST_PROXY=0

# Nonce-based Content Security Policy. Keep enabled; 0 is for local debugging.
CSP_ENABLED=1
